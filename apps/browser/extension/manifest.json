{
  "manifest_version": 3,
  "name": "Girru Browser",
  "version": "0.1.0",
  "description": "Device sizes and local Chrome-data import for Girru Browser.",
  "key": "",
  "permissions": [
    "bookmarks",
    "history",
    "tabs",
    "cookies",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Device size",
    "default_popup": "devices.html",
    "default_icon": {
      "16": "device.png",
      "32": "device.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"
  }
}
